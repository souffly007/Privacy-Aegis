{
  "manifest_version": 3,
  "name": "Privacy Aegis",
  "version": "2.0.0",
  "description": "Protection complète contre le tracking, fingerprinting, publicités. Bloque les trackers, cookies tiers, WebRTC et plus.",
  "author": "souffly007",
  "homepage_url": "https://github.com/souffly007/privacy-shield-pro",

  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-aegis@souffly007.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "notifications",
    "webRequest",
    "webRequestBlocking"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Privacy Aegis",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
